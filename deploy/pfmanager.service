[Unit]
Description=PfManager pfSense management server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=pfmanager
Group=pfmanager
WorkingDirectory=/opt/pfmanager/server
EnvironmentFile=/etc/pfmanager/pfmanager.env
ExecStart=/opt/pfmanager/venv/bin/uvicorn app.main:app_factory --factory --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pfmanager
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
