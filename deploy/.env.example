# Public DNS name of this server. Caddy obtains a Let's Encrypt certificate for it,
# so it must resolve to this host and ports 80/443 must be reachable.
CSFM_DOMAIN=comsense.example.com
ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Generate both with:  docker compose run --rm app python -m app.cli keygen
CSFM_SECRET_KEY=
# Losing this key makes every stored backup unreadable. Keep a copy somewhere safe.
CSFM_BACKUP_ENCRYPTION_KEY=

# First admin account, created on first start only. Change the password after logging in.
CSFM_INITIAL_ADMIN_USER=admin
CSFM_INITIAL_ADMIN_PASSWORD=

# Optional tuning (defaults shown).
# CSFM_CHECKIN_INTERVAL=60          seconds between agent check-ins
# CSFM_OFFLINE_AFTER=300            seconds without a check-in before a firewall is offline
# CSFM_SCHEDULED_BACKUP_HOURS=24    queue a backup if none was taken in this many hours (0 = off)
# CSFM_BACKUP_RETENTION_COUNT=5     unpinned backups kept per firewall (pinned ones are extra)
# CSFM_TASK_RETENTION_DAYS=90      finished task history kept (0 = forever)
# CSFM_METRICS_RETENTION_DAYS=30
# CSFM_MAX_BACKUP_BYTES=33554432
# CSFM_SESSION_MAX_AGE=28800
