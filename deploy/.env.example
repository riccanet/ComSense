# Settings for docker-compose.caddy.yml and docker-compose.byo-proxy.yml.
# Copy to deploy/.env (Docker Compose) or enter as stack variables (Portainer).

# DNS name of the web console (and, unless CSFM_AGENT_DOMAIN is set, of the agent port).
CSFM_DOMAIN=comsense.example.com

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Generate with:
#   echo CSFM_SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n/+=')
#   echo CSFM_BACKUP_ENCRYPTION_KEY=$(openssl rand -base64 32 | tr '+/' '-_')
CSFM_SECRET_KEY=
# Losing this key makes every stored backup unreadable. Keep a copy somewhere safe.
CSFM_BACKUP_ENCRYPTION_KEY=

# First admin. On first start it gets a random one-time password, written to the
# app log (docker logs comsense-app); it must be changed at first sign-in.
CSFM_INITIAL_ADMIN_USER=admin

# --- Agent listener (both options) -----------------------------------------
# Port firewalls connect to; forward it through NAT to this host.
# CSFM_AGENT_PORT_PUBLIC=8443
# Host address to publish it on (default all addresses).
# CSFM_AGENT_BIND=0.0.0.0
# DNS name firewalls use for the agent port, if different from CSFM_DOMAIN
# (for example when CSFM_DOMAIN points at a proxy or CDN).
# CSFM_AGENT_DOMAIN=agents.example.com
# Extra names/IPs for the agent port's self-issued certificate, comma separated.
# CSFM_AGENT_TLS_NAMES=203.0.113.10

# --- Bring-your-own-proxy option only ---------------------------------------
# Address and port the plain-HTTP web console is published on, for your proxy.
# CSFM_WEB_BIND=127.0.0.1
# CSFM_WEB_PORT_PUBLIC=8000

# --- Optional tuning (defaults shown) ---------------------------------------
# CSFM_CHECKIN_INTERVAL=60          seconds between agent check-ins
# CSFM_BACKUP_RETENTION_COUNT=5     unpinned backups kept per firewall
# CSFM_METRICS_RETENTION_DAYS=30
# CSFM_TASK_RETENTION_DAYS=90
