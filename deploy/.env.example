# Public DNS name of this server. Caddy obtains a Let's Encrypt certificate for it,
# so it must resolve to this host and ports 80/443 must be reachable.
PFM_DOMAIN=pfmanager.example.com
ACME_EMAIL=admin@example.com

POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Generate both with:  docker compose run --rm app python -m app.cli keygen
PFM_SECRET_KEY=
# Losing this key makes every stored backup unreadable. Keep a copy somewhere safe.
PFM_BACKUP_ENCRYPTION_KEY=

# First admin account, created on first start only. Change the password after logging in.
PFM_INITIAL_ADMIN_USER=admin
PFM_INITIAL_ADMIN_PASSWORD=

# Optional tuning (defaults shown).
# PFM_CHECKIN_INTERVAL=60          seconds between agent check-ins
# PFM_OFFLINE_AFTER=300            seconds without a check-in before a firewall is offline
# PFM_SCHEDULED_BACKUP_HOURS=24    queue a backup if none was taken in this many hours (0 = off)
# PFM_BACKUP_RETENTION_COUNT=100   unpinned backups kept per firewall
# PFM_METRICS_RETENTION_DAYS=30
# PFM_MAX_BACKUP_BYTES=33554432
# PFM_SESSION_MAX_AGE=28800
