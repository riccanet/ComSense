[Unit]
Description=ComSense pfSense management server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=comsense
Group=comsense
WorkingDirectory=/opt/comsense/server
EnvironmentFile=/etc/comsense/comsense.env
# Web console on 127.0.0.1:8000 for Caddy; agent listener with its own TLS on CSFM_AGENT_PORT.
Environment=CSFM_WEB_HOST=127.0.0.1 CSFM_FORWARDED_ALLOW_IPS=127.0.0.1
ExecStart=/opt/comsense/venv/bin/python -m app.serve
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/comsense
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
